# ─────────────────────────────────────────────────────────
# backend/.env — local environment variables
#
# ⚠️  NEVER commit this file. It's already covered by the
#     root .gitignore (the *.env and .env patterns).
#
# Fill in DB_PASSWORD with your actual MySQL root password
# before starting the server.
# ─────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=3306
DB_NAME=yojsetu_db
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
